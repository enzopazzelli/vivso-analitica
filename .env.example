# Copiar este archivo a .env y completar lo que haga falta. El .env nunca se sube al repositorio.

# De dónde lee el servicio: simulado, mysql, api o vacio (vacio apaga el simulador y deja todo vacío).
ANALITICA_ORIGEN=simulado

# Conexión de solo lectura a la base de Desarrollo (usuario lector). Forma:
# ANALITICA_MYSQL_URL=mysql+pymysql://lector:CLAVE@HOST:PUERTO/vivso3
ANALITICA_MYSQL_URL=
# Ruta al certificado de la autoridad (CA) de la base; vacío = conexión sin cifrar.
ANALITICA_MYSQL_SSL_CA=

# API REST del sistema de Desarrollo (respaldo, para cuando el backend esté desplegado).
ANALITICA_VIVSO_API_URL=
ANALITICA_VIVSO_API_USUARIO=
ANALITICA_VIVSO_API_CLAVE=

# Base propia del servicio (historia e indicadores).
ANALITICA_DB_URL=sqlite:///datos_locales/analitica.db
# Minutos entre sincronizaciones.
ANALITICA_INTERVALO_MIN=30

# Claves de la API del servicio: una de lectura y otra de administración.
ANALITICA_CLAVE_LECTURA=
ANALITICA_CLAVE_ADMIN=
# Orígenes web que pueden consultar la API, separados por coma.
ANALITICA_CORS_ORIGENES=

# Dónde encuentra el tablero a la API; vacío = calcula con el origen en el mismo proceso.
ANALITICA_API_URL=

# Feriados: de dónde se bajan y qué tipos cuentan como días no hábiles.
ANALITICA_FERIADOS_URL=https://api.argentinadatos.com/v1/feriados/{año}
ANALITICA_FERIADOS_TIPOS=inamovible,trasladable,puente
